{
  "name": "siyuan-docseeker",
  "version": "0.1.0",
  "description": "Plugin SiYuan : recherche plein texte dans les PDF avec vignettes surlignées",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "siyuan": "^1.2.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
